.DEFAULT_GOAL := help
SHELL := /bin/bash
# The platform checkout. CI checks it out elsewhere and sets PLATFORM_PATH. `pyproject.toml` and
# `uv.lock` name it as `.platform/`, a link made here, so they hold no path of this machine.
PLATFORM_PATH ?= {{ platform_path }}
PLATFORM := $(PLATFORM_PATH)
IMAGE ?= {{ agent_name }}
IMAGE_METADATA ?= build/image-metadata.json
PORT ?= 9000
# Offline, as the platform's `make test`: no socket but Unix sockets and loopback (the kit runs the
# workload and the chassis as local processes), and no key in the environment.
PYTEST_FLAGS := --disable-socket --allow-unix-socket --allow-hosts=127.0.0.1,::1
STRIP_KEYS := for v in $$(env | cut -d= -f1 | grep -E '(_API_KEY|_TOKEN|_SECRET|_PASSWORD)$$' || true); do unset "$$v"; done

.PHONY: platform help setup test lint fmt run image sign load-smoke hostile redteam eval

platform: ## Point .platform at PLATFORM_PATH
	@ln -sfn $(PLATFORM_PATH) .platform

help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z0-9_-]+:.*##/ {printf "  %-8s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

setup: platform ## Install Python 3.12 and the locked dependencies (writes uv.lock; commit it)
	uv sync

test: platform ## Every test, offline: the unit tests and the lane contract over A2A
	@$(STRIP_KEYS); uv run pytest $(PYTEST_FLAGS) --ignore=tests/suites $(ARGS)

lint: platform ## ruff and mypy, strict
	uv run ruff format --check .
	uv run ruff check .
	uv run mypy

fmt: platform ## Format
	uv run ruff format .
	uv run ruff check --fix .

run: platform ## Serve handle over A2A on loopback (the chassis reaches it at 127.0.0.1:$(PORT))
	uv run workload-a2a serve --handle {{ package_name }}:handle --name {{ agent_name }} --version 0.1.0 --port $(PORT)

image: platform ## Build the hardened workload image: make image [IMAGE=ref] [PUSH=1 IMAGE_METADATA=file]
ifeq ($(PUSH),1)
	mkdir -p $(dir $(IMAGE_METADATA))
	docker buildx build --build-context workload-a2a=$(PLATFORM)/packages/workload-a2a -t $(IMAGE) \
		--push --sbom=true --provenance=mode=max --metadata-file $(IMAGE_METADATA) .
else
	docker buildx build --build-context workload-a2a=$(PLATFORM)/packages/workload-a2a -t $(IMAGE) \
		--load .
endif

sign: ## suggested: cosign keyless signing of a pushed digest: make sign IMAGE_REF=ref@sha256:...
	@test -n "$(IMAGE_REF)" || { echo "set IMAGE_REF=<image>@<digest>"; exit 2; }
	cosign sign --yes $(IMAGE_REF)

# This agent's own suites (agent_testkit.suites), offline. The platform's full suites, on a real
# cluster and every engine, stay in the platform's CI.
load-smoke: platform ## Concurrent runs through the chassis
	@$(STRIP_KEYS); uv run pytest $(PYTEST_FLAGS) tests/suites/test_load_smoke.py $(ARGS)

hostile: platform ## This agent's source, image, and Compose file against ADR-001
	@$(STRIP_KEYS); uv run pytest $(PYTEST_FLAGS) tests/suites/test_hostile.py $(ARGS)

redteam: platform ## Attacks on the input, through the chassis guard stage
	@$(STRIP_KEYS); uv run pytest $(PYTEST_FLAGS) tests/suites/test_redteam.py $(ARGS)

eval: platform ## The golden cases in evals/cases.yaml; writes reports/eval.json
	@$(STRIP_KEYS); uv run pytest $(PYTEST_FLAGS) tests/suites/test_eval.py $(ARGS)
