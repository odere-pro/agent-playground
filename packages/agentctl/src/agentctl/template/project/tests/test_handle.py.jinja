@pytest.fixture(autouse=True)
def model() -> Iterator[None]:
    """The fake model on an in-memory transport; the tool endpoint refuses, so no tools run."""
    handle_module.transport = httpx.ASGITransport(app=create_app(SCRIPT))
    tools_module.client_factory = lambda headers, timeout: httpx2.AsyncClient(
        transport=httpx2.MockTransport(_refuse), headers=headers, timeout=timeout
    )
    yield
    handle_module.transport = None
    tools_module.client_factory = tools_module.default_client_factory
