async def _run(text: str) -> list[dict[str, Any]]:
    events = [e async for e in handle({"text": text, "data": {}}, CTX)]
    for event in events:
        jsonschema.validate(event, EVENTS_SCHEMA)
    kinds = [e["type"] for e in events]
    assert kinds[0] == "start" and kinds[-1] in ("end", "error")
    return events


def test_handle_is_an_async_generator() -> None:
    assert inspect.isasyncgenfunction(handle)


{%- if framework != 'python' %}


def test_a_timeout_maps_to_one_schema_valid_error() -> None:
    event = error_event(TimeoutError("slow"))
    jsonschema.validate(event, EVENTS_SCHEMA)
    assert event["type"] == "error"
{%- endif %}
{%- if framework in ['python', 'pydanticai', 'langgraph', 'openai-agents'] %}


async def test_streams_the_reply_then_metrics_and_end() -> None:
    events = await _run("simplify: the quick brown fox")
    kinds = [e["type"] for e in events]
    assert kinds[-2:] == ["metrics", "end"]
    assert "".join(e["text"] for e in events if e["type"] == "delta") == REPLY
    assert (events[-2]["input_tokens"], events[-2]["output_tokens"]) == (42, 9)


async def test_a_model_failure_is_one_error_event() -> None:
    events = await _run("fail please")
    assert [e["type"] for e in events] == ["start", "error"]
    assert events[-1]["code"] == "http_500" and events[-1]["retryable"] is True
{%- elif framework == 'smolagents' %}


async def test_an_unreachable_model_is_one_error_event() -> None:
    events = await _run("simplify: x")
    assert [e["type"] for e in events] == ["start", "error"]
    assert events[-1]["code"] == "connect_error"
