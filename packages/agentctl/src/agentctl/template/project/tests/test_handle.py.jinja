def _tool_stub() -> FastMCP:
    server: FastMCP = FastMCP(name="chassis-tools-stub")

    @server.tool
    def glossary_lookup(term: str) -> dict[str, str]:
        """Look up a platform term."""
        return {"term": term, "definition": "stub"}

    return server


@asynccontextmanager
async def _lifespan(app: Any) -> AsyncIterator[None]:
    """The MCP stub's lifespan in a task of its own: anyio's cancel scopes must exit there."""
    ready, stop = asyncio.Event(), asyncio.Event()

    async def hold() -> None:
        async with app.router.lifespan_context(app):
            ready.set()
            await stop.wait()

    task = asyncio.create_task(hold())
    await ready.wait()
    try:
        yield
    finally:
        stop.set()
        await task


@pytest.fixture(autouse=True)
async def model(monkeypatch: pytest.MonkeyPatch) -> AsyncIterator[None]:
    """The fake model and a stub of the chassis tool endpoint, both on in-memory transports."""
    mcp_app = _tool_stub().http_app(path="/mcp", stateless_http=True)
    model_app = create_app(SCRIPT)
    monkeypatch.setattr(handle_module, "model_transport", httpx2.ASGITransport(app=model_app))
    monkeypatch.setattr(handle_module, "tool_transport", httpx2.ASGITransport(app=mcp_app))
    async with _lifespan(mcp_app):
        yield
