"""The stateless check (057 H-19) in the `sidecar` lane: real processes, a read-only root on both.

The workload and the chassis (`fake` profile) each run as their own process with a read-only root
(`agent_testkit.readonly_root`). The same requests run on fresh pods and on one reused pod, in
shuffled order, through the chassis. A write by either container (also while it stops), a file
left in a scratch volume, or an answer that differs on the reused pod fails the test and names the
container or the call. Keep what must outlive a call behind the chassis (`StatePort`), never on
local disk.
"""

from __future__ import annotations

from agent_testkit.settings import AgentRef, ChassisSource
from agent_testkit.stateless_lane import LanePods, check_lane

REQUESTS = [
    {"text": "simplify: the quick brown fox", "data": {}},
    {"text": "something else", "data": {}},
    {"text": "simplify: a second text", "data": {}},
]
MODEL_SCRIPT = [{"match": "simplify", "reply": "Plain words. Short sentences. Same facts."}]
# suggested: 120 s per process start, what the platform's own kit tests need on a loaded machine.
START_S = 120.0
{%- if framework == 'claude-agent' %}
# The Claude Code CLI needs a HOME on disk. In the pod it is under /tmp, a memory-backed emptyDir;
# here it is a fresh folder per pod, and it must be empty once each call is done.
SCRATCH_VAR: str | None = "CLAUDE_AGENT_HOME_BASE"
{%- elif framework == 'smolagents' %}
# `filelock` (a smolagents dependency) makes and removes a temp folder when it is imported. In the
# pod /tmp is a memory-backed emptyDir; here TMPDIR is a fresh folder per pod, and it must be
# empty once each call is done.
SCRATCH_VAR: str | None = "TMPDIR"
{%- else %}
# No writable volume: any write fails.
SCRATCH_VAR: str | None = None
{%- endif %}


def test_no_data_is_kept_on_disk_or_between_calls_in_the_sidecar_lane(
    agent_handle_ref: AgentRef, agent_testkit_chassis_source: ChassisSource
) -> None:
    pods = LanePods(
        agent_handle_ref,
        agent_testkit_chassis_source,
        model_script=MODEL_SCRIPT,
        scratch_var=SCRATCH_VAR,
        start_s=START_S,
    )

    report = check_lane(pods, REQUESTS, seed=1)

    assert report.read_only == ("workload", "chassis")
    assert len(report.outputs) == len(REQUESTS)
