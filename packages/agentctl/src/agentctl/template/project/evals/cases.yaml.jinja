# The golden cases `make eval` runs through the chassis. Each case: `id`, `input`, and `expect`.
# `expect.status`: the status the run must end with (default: ok or fallback). `expect.contains`:
# text the JSON of the output must hold. The fake model answers `ok` to every call, so the case
# below checks the plumbing only. Add cases on what your logic adds.
cases:
  - id: greeting
    input: {text: hello big world}
{%- if framework == 'smolagents' %}
    # The fake model writes no `<code>` block, so this ends in an error (tests/test_contract.py).
    # Replace it when you give the agent a model that does.
    expect: {status: error}
{%- else %}
    expect: {contains: ok}
{%- endif %}
