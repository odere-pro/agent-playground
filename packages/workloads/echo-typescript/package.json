{
  "name": "echo-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "The echo simplifier in TypeScript over @a2a-js/sdk: contract v0 carries nothing Python-specific",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/src/main.js",
    "fixture": "tsx scripts/write-fixture.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
