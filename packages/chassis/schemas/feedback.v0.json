{
  "additionalProperties": false,
  "description": "The payload of `agents.feedback.received.v1` (PoC-7, suggested). The comment is redacted\n(`chassis.redaction.redact`) before it is put here.",
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "feedback_id": {
      "title": "Feedback Id",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "feedback_id",
    "request_id",
    "trace_id",
    "agent",
    "score",
    "received_at"
  ],
  "title": "FeedbackReceived",
  "type": "object"
}
