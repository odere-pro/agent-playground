{
  "uid": "chassis-echo-typescript-remote",
  "title": "Agent echo-typescript-remote",
  "tags": [
    "chassis",
    "agent"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data"
      },
      {
        "name": "langfuse_url",
        "type": "textbox",
        "query": "",
        "label": "Langfuse URL"
      },
      {
        "name": "langfuse_project",
        "type": "textbox",
        "query": "",
        "label": "Langfuse project id"
      },
      {
        "name": "loki_uid",
        "type": "textbox",
        "query": "",
        "label": "Loki datasource uid"
      },
      {
        "name": "filters",
        "type": "adhoc",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Filters"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by interface and status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (interface, status) (rate(chassis_run_duration_seconds_count{agent=\"echo-typescript-remote\"}[5m]))",
          "legendFormat": "{{interface}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency (p50, p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chassis_run_duration_seconds_bucket{agent=\"echo-typescript-remote\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chassis_run_duration_seconds_bucket{agent=\"echo-typescript-remote\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors by code",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(chassis_run_errors_total{agent=\"echo-typescript-remote\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model tokens by direction",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(chassis_model_tokens_total{agent=\"echo-typescript-remote\"}[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model cost (USD per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (increase(chassis_model_cost_microusd_total{agent=\"echo-typescript-remote\"}[1h])) / 1e6",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evaluator gate sync runs with no fallback",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(rate(chassis_gate_fallbacks_total{agent=\"echo-typescript-remote\"}[5m])) / sum(rate(chassis_gate_runs_total{agent=\"echo-typescript-remote\",mode=\"sync\"}[5m]))",
          "legendFormat": "no fallback"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Evaluator gate retry rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chassis_gate_retries_total{agent=\"echo-typescript-remote\"}[5m])) / sum(rate(chassis_gate_runs_total{agent=\"echo-typescript-remote\",mode=\"sync\"}[5m]))",
          "legendFormat": "retry rate"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Evaluator gate fallback rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chassis_gate_fallbacks_total{agent=\"echo-typescript-remote\"}[5m])) / sum(rate(chassis_gate_runs_total{agent=\"echo-typescript-remote\",mode=\"sync\"}[5m]))",
          "legendFormat": "fallback rate"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "User feedback by label",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Langfuse traces",
          "url": "${langfuse_url}/project/${langfuse_project}/traces?search=echo-typescript-remote",
          "targetBlank": true
        },
        {
          "title": "Loki logs",
          "url": "/explore?left={%22datasource%22:%22${loki_uid}%22,%22queries%22:%5B{%22refId%22:%22A%22,%22expr%22:%22{agent%3D%5C%22echo-typescript-remote%5C%22}%22}%5D,%22range%22:{%22from%22:%22${__from}%22,%22to%22:%22${__to}%22}}",
          "targetBlank": true
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (increase(chassis_feedback_total{agent=\"echo-typescript-remote\"}[1h]))",
          "legendFormat": "{{label}}"
        }
      ]
    }
  ]
}
