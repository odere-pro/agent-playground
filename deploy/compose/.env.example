# Copy to `.env` (untracked). Every value is empty here; the `fake` variant runs with all of them empty.
# Rules: SECURITY.md. Never commit `.env`.

# LiteLLM's admin key. Goes to the LiteLLM container only. suggested: `sk-` plus a random string.
LITELLM_MASTER_KEY=
# The key the chassis sends to LiteLLM. Goes to the chassis container only.
# PoC-1 only: set it to the same value as LITELLM_MASTER_KEY (debt, see SECURITY.md section 1).
LITELLM_API_KEY=
# Provider key for `big-default` in the `local` variant. Goes to the LiteLLM container only.
OPENAI_API_KEY=
# Provider base URL for `big-default` in the `local` variant. Empty means https://api.openai.com/v1.
OPENAI_API_BASE=
# Provider model for `big-default` in the `local` variant, e.g. openai/gpt-4o-mini.
BIG_DEFAULT_MODEL=
# Absolute path to a GGUF file on this machine, served by llama.cpp as `local-small`.
LLAMA_MODEL_PATH=
